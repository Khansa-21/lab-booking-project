PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
DB_HOST=localhost
DB_PORT=1433
DB_NAME=LabBookingDb
DB_USER=lab_booking_app
DB_PASSWORD=replace_with_your_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Used only when creating development users with db:seed
SEED_USER_PASSWORD=replace_with_a_strong_development_password

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# Transactional email (Brevo)
BREVO_API_KEY=replace_with_your_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=University Resource Hub
